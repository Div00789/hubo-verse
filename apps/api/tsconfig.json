{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@huboverse/types": ["../../packages/types/src"],
      "@huboverse/database": ["../../packages/database/src"],
      "@huboverse/hubspot-sdk": ["../../packages/hubspot-sdk/src"],
      "@huboverse/ai-agent": ["../../packages/ai-agent/src"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strict": false
  }
}
