{
  "name": "huboverse-monorepo",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:app": "pnpm --filter huboverse-app dev",
    "dev:web": "pnpm --filter huboverse-web dev",
    "dev:admin": "pnpm --filter huboverse-admin dev",
    "dev:api": "pnpm --filter huboverse-api dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "prettier": "^3.5.1"
  }
}
